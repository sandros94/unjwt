{
  "name": "unjwt",
  "version": "0.8.5",
  "description": "A collection of JWT utilities based on the Web Crypto API.",
  "keywords": [
    "auth",
    "browser",
    "decrypt",
    "edge",
    "encrypt",
    "jose",
    "jwe",
    "jwk",
    "jws",
    "jwt",
    "security",
    "serverless",
    "session",
    "sign",
    "verify",
    "webcrypto"
  ],
  "homepage": "https://unjwt.s94.dev",
  "license": "MIT",
  "author": {
    "name": "Sandro Circi",
    "email": "sandro.circi@digitoolmedia.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandros94/unjwt.git"
  },
  "funding": {
    "url": "https://github.com/sponsors/sandros94"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "browser": {
    "buffer": false
  },
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./jwk": {
      "types": "./dist/core/jwk/index.d.mts",
      "default": "./dist/core/jwk/index.mjs"
    },
    "./jws": {
      "types": "./dist/core/jws/index.d.mts",
      "default": "./dist/core/jws/index.mjs"
    },
    "./jwe": {
      "types": "./dist/core/jwe/index.d.mts",
      "default": "./dist/core/jwe/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "default": "./dist/utils/index.mjs"
    },
    "./error": {
      "types": "./dist/error.d.mts",
      "default": "./dist/error.mjs"
    },
    "./session": {
      "types": "./dist/session/index.d.mts",
      "default": "./dist/session/index.mjs"
    },
    "./dpop": {
      "types": "./dist/dpop/index.d.mts",
      "default": "./dist/dpop/index.mjs"
    },
    "./internal": {
      "types": "./dist/core/internal.d.mts",
      "default": "./dist/core/internal.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "dev": "pnpm --dir playgrounds/h3 dev",
    "docs": "pnpm --filter unjwt-docs dev",
    "dev:nuxt": "pnpm --dir playgrounds/nuxt-4 dev",
    "dev:nitro": "pnpm --dir playgrounds/nitro dev",
    "dev:prepare": "obuild --stub && pnpm --dir playgrounds/nuxt-4 prepare && pnpm simple-git-hooks",
    "lint": "oxlint --deny-warnings . && oxfmt --check .",
    "size": "vitest run test/bundle.test.ts --reporter=./test/_size-reporter.ts",
    "fmt": "automd && oxlint --fix . && oxfmt .",
    "prepack": "pnpm build",
    "test": "vitest run --slowTestThreshold=1000",
    "test:coverage": "vitest run --coverage --slowTestThreshold=1000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples && tsc --noEmit -p test/examples",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "automd": "^0.4.3",
    "cookie-es": "^3.1.1",
    "h3": "^2.0.5",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "obuild": "^0.4.45",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "rolldown": "1.2.14",
    "simple-git-hooks": "^2.14.0",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "unsecure": "^0.3.4",
    "vitest": "^5.0.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm build --stub && pnpm lint && pnpm typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.17.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.11.2"
}
