{
  "name": "unjwt",
  "version": "0.7.3",
  "description": "Low-level JWT utilities",
  "license": "MIT",
  "author": {
    "name": "Sandro Circi",
    "email": "sandro.circi@digitoolmedia.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandros94/unjwt.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./jwk": {
      "types": "./dist/core/jwk.d.mts",
      "default": "./dist/core/jwk.mjs"
    },
    "./jws": {
      "types": "./dist/core/jws.d.mts",
      "default": "./dist/core/jws.mjs"
    },
    "./jwe": {
      "types": "./dist/core/jwe.d.mts",
      "default": "./dist/core/jwe.mjs"
    },
    "./utils": {
      "types": "./dist/core/utils/index.d.mts",
      "default": "./dist/core/utils/index.mjs"
    },
    "./adapters/h3": {
      "types": "./dist/adapters/h3v1/index.d.mts",
      "default": "./dist/adapters/h3v1/index.mjs"
    },
    "./adapters/h3v1": {
      "types": "./dist/adapters/h3v1/index.d.mts",
      "default": "./dist/adapters/h3v1/index.mjs"
    },
    "./adapters/h3v2": {
      "types": "./dist/adapters/h3v2/index.d.mts",
      "default": "./dist/adapters/h3v2/index.mjs"
    },
    "./adapters/elysia": {
      "types": "./dist/adapters/elysia/index.d.mts",
      "default": "./dist/adapters/elysia/index.mjs"
    }
  },
  "scripts": {
    "build": "obuild",
    "dev": "bun --watch ./playground/main.ts",
    "dev:prepare": "obuild --stub && pnpm simple-git-hooks",
    "lint": "oxlint . && oxfmt --check .",
    "fmt": "automd && oxlint --fix . && oxfmt .",
    "prepack": "pnpm build",
    "test": "vitest run --slowTestThreshold=1000",
    "test:coverage": "vitest run --coverage --slowTestThreshold=1000",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "automd": "^0.4.3",
    "cookie-esv1": "npm:cookie-es@^1.2.3",
    "cookie-esv3": "npm:cookie-es@^3.1.1",
    "elysia": "^1.4.29",
    "h3v1": "npm:h3@^1.15.11",
    "h3v2": "npm:h3@^2.0.1-rc.29",
    "jose": "^6.2.10",
    "obuild": "^0.4.38",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "rolldown": "1.2.5",
    "simple-git-hooks": "^2.13.1",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "unsecure": "^0.2.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "cookie-es": "^1.2.3 || ^3.1.1",
    "elysia": "^1.4.29",
    "h3": "^1.15.4 || >=2.0.1-rc.22 || ^2.0.1",
    "rou3": "^0.8.1"
  },
  "peerDependenciesMeta": {
    "cookie-es": {
      "optional": true
    },
    "elysia": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "rou3": {
      "optional": true
    }
  },
  "resolutions": {
    "unjwt": "link:."
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm build --stub && pnpm lint && pnpm typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.17.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@11.23.0"
}
